diff --git a/src/keyboard_state.hpp b/src/keyboard_state.hpp
new file mode 100644
index 0000000..5ef63f9
--- /dev/null
+++ b/src/keyboard_state.hpp
@@ -0,0 +1,44 @@
+#pragma once
+
+#include <set>
+#include <cstdint>
+#include <xkbcommon/xkbcommon.h>
+
+namespace hkcf {
+
+// The virtual-keyboard protocol requires explicit modifier notifications.
+class KeyboardState {
+public:
+    ~KeyboardState() { reset(nullptr); }
+    bool reset(xkb_keymap* keymap) {
+        if (m_state)
+            xkb_state_unref(m_state);
+        m_state = keymap ? xkb_state_new(keymap) : nullptr;
+        m_pressed.clear();
+        return m_state != nullptr;
+    }
+    bool update(std::uint32_t evdev, bool pressed) {
+        if (!m_state || m_pressed.contains(evdev) == pressed)
+            return false;
+        if (pressed)
+            m_pressed.insert(evdev);
+        else
+            m_pressed.erase(evdev);
+        xkb_state_update_key(m_state, evdev + 8, pressed ? XKB_KEY_DOWN : XKB_KEY_UP);
+        return true;
+    }
+    xkb_mod_mask_t mods(xkb_state_component component) const {
+        return m_state ? xkb_state_serialize_mods(m_state, component) : 0;
+    }
+    xkb_layout_index_t group() const {
+        return m_state ? xkb_state_serialize_layout(m_state, XKB_STATE_LAYOUT_EFFECTIVE) : 0;
+    }
+    KeyboardState() = default;
+    KeyboardState(const KeyboardState&) = delete;
+    KeyboardState& operator=(const KeyboardState&) = delete;
+private:
+    xkb_state* m_state = nullptr;
+    std::set<std::uint32_t> m_pressed;
+};
+
+} // namespace hkcf
